{
  "name": "hisaab",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "abi": "npm run abi -w @hisaab/core",
    "deploy:local": "npm run deploy:local -w dev-console",
