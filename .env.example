# Select the chain profile used by the API. Profiles are defined in network.mjs.
# Kept as VITE_NETWORK for compatibility with existing tooling.
VITE_NETWORK=sepolia

# Optional network-specific RPC overrides. The selected profile uses its own
# override, or its default RPC URL when this is unset.
# VITE_SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# VITE_MAINNET_RPC_URL=https://ethereum-rpc.publicnode.com

# Optional API port. Defaults to 3000.
# PORT=3000
